<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Zone vidéo plein écran -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.golfswing.analyzer.AspectFrameLayout
            android:id="@+id/aspectLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <TextureView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.golfswing.analyzer.TrajectoryView
                android:id="@+id/trajectoryView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.golfswing.analyzer.AspectFrameLayout>

        <!-- Barre du haut : fermer + format de capture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass"
                android:contentDescription="Fermer"
                android:src="@drawable/ic_close"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tvFormat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass"
                android:ellipsize="end"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Indication contextuelle (repérage, résultats) -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_glass"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- Carte de contrôle façon lecteur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_glass"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="#00E676"
            android:thumbTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="0.0 s / 0.0 s"
                android:textColor="#B0B0B0"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="1×"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="Lecture ou pause"
                android:padding="14dp"
                android:src="@drawable/ic_play" />
        </LinearLayout>
    </LinearLayout>

    <!-- Résultats et actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_solid"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Mode manuel : pas de détection automatique, la courbe passe par les points posés à la main -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManual"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mode manuel : désactivé"
            android:textColor="#B0B0B0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#00E676"
                android:text="@string/btn_analyze"
                android:textColor="#001A0B"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTraced"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_save_traced"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_save"
            android:textColor="#B0B0B0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgain"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_again"
            android:textColor="#B0B0B0" />
    </LinearLayout>
</LinearLayout>
